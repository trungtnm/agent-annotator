{
  "name": "@trungtnm/agent-annotator",
  "version": "0.2.0",
  "description": "A development-only overlay for React apps: comment on elements, text and areas of the running UI, then copy one Markdown prompt for a coding agent (JSX file:line, component chain and PII-redacted props/state per comment), or capture the tab and mark it up like Shottr.",
  "license": "MIT",
  "author": "trungtnm",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trungtnm/agent-annotator.git"
  },
  "homepage": "https://github.com/trungtnm/agent-annotator#readme",
  "bugs": "https://github.com/trungtnm/agent-annotator/issues",
  "keywords": [
    "react",
    "nextjs",
    "devtools",
    "annotation",
    "ai",
    "coding-agent",
    "prompt",
    "screenshot"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "prepublishOnly": "pnpm check",
    "media:shots": "node scripts/media/record.mjs shots",
    "media:video": "node scripts/media/record.mjs video && node scripts/media/compose.mjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "10.6.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.7.0",
    "jsdom": "29.1.1",
    "playwright": "1.61.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "tsup": "8.5.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.62.1",
    "vitest": "4.1.11"
  }
}
